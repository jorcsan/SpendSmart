<% content_for :title, "Categories" %>

<h1>Categories</h1>

<div id="categories">
  <% if @categories.any? %>
    <% @categories.each do |category| %>
      <%= render category %>
      <p class="category-actions">
        <%# US-8: every category links to its own spending page. %>
        <%= link_to "View expenses and total", category %> |
        <%= link_to "Edit", edit_category_path(category) %>
      </p>
    <% end %>
  <% else %>
    <p class="empty-state">
      No categories yet. <%= link_to "Add one", new_category_path %>.
    </p>
  <% end %>
</div>

<%= link_to "New category", new_category_path %>
