<div id="<%= dom_id expense %>" class="expense">
  <div>
    <strong>Description:</strong>
    <%= expense.description %>
  </div>

  <div>
    <strong>Price:</strong>
    <%= number_to_currency(expense.price) %>
  </div>

  <div>
    <strong>Date:</strong>
    <%= expense.date&.strftime("%b %-d, %Y") %>
  </div>

  <div>
    <strong>Account:</strong>
    <%# Names, not raw foreign keys - the id means nothing to a user. %>
    <%= expense.account&.name %>
  </div>

  <div>
    <strong>Category:</strong>
    <%= expense.category&.name %>
  </div>
</div>
